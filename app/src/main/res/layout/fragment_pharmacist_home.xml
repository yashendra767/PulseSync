<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_dove"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/helloText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello Pharma"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:fontFamily="@font/inter"
            android:textColor="@color/black" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/primary_red"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/white_dove">

            <TextView
                android:id="@+id/tvLowStockCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Low stock items: 0"
                android:textSize="18sp"
                android:textColor="@color/primary_red"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:padding="14dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Total Dispensed Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/primary_green"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/white_dove">

            <TextView
                android:id="@+id/tvTotalDispensed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total items dispensed: 0"
                android:textSize="18sp"
                android:textColor="@color/primary_green_dark"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:padding="14dp" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLowStock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_no_low_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inventory is in stock for now"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@android:color/darker_gray"
            android:padding="16dp"
            android:fontFamily="@font/inter" />

    </LinearLayout>
</FrameLayout>
