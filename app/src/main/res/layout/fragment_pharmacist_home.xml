<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/helloText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textStyle="bold"
            android:text="Hello Pharma"
            android:fontFamily="@font/lufga_regular">
        </TextView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="10dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/primary_red"
            app:cardElevation="4dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvLowStockCount"
                android:text="Low stock items: 0"
                android:textSize="20sp"
                android:padding="7dp"
                android:fontFamily="@font/lufga_regular"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/primary_green"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTotalDispensed"
                android:text="Total items dispensed: 0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/lufga_regular"
                android:padding="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLowStock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/tv_no_low_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inventory is in stock for now"
            android:textSize="18sp"
            android:gravity="center"
            android:visibility="gone"
            android:padding="16dp"
            android:fontFamily="@font/lufga_regular" />

    </LinearLayout>
</FrameLayout>
