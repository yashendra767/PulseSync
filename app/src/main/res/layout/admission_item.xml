<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    app:cardElevation="5dp"
    app:cardCornerRadius="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lufga_regular"
                android:textSize="20dp"
                android:text="Patient: John Doe"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvBedId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lufga_regular"
                android:textSize="16sp"
                android:text="Bed ID: 101"/>

            <TextView
                android:id="@+id/tvAdmissionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/source_sans_pro"
                android:textSize="16sp"
                android:text="Date: 12-05-2025"/>

            <TextView
                android:id="@+id/tvAdmissionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lufga_regular"
                android:textSize="16sp"
                android:text="Status: Admitted"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/deleteAdmission"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/discharge">
        </ImageView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
