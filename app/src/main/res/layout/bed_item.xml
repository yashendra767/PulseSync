<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/primary_green"
    app:strokeWidth="1dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/white_dove">

        <TextView
            android:id="@+id/tvBedId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bed ID: 101"
            android:textStyle="bold"
            android:textSize="18sp"
            android:fontFamily="@font/inter" />

        <TextView
            android:id="@+id/tvBedType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type: ICU"
            android:textSize="14sp"
            android:fontFamily="@font/inter" />

        <TextView
            android:id="@+id/tvBedStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Occupied"
            android:textSize="14sp"
            android:fontFamily="@font/inter" />

        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient: John Doe"
            android:textSize="14sp"
            android:fontFamily="@font/inter" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
