<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pharmacist_drawer_layout"
    android:layout_width="match_parent"
    android:background="@color/white_dove"
    android:layout_height="match_parent"
    tools:context=".pharmacist.PharmacistDashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/pharmacist_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_red"
            app:title="Pharmacist Dashboard"
            app:titleTextColor="@android:color/white" />

        <FrameLayout
            android:id="@+id/pharmacist_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/pharmacist_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white_dove"
            app:menu="@menu/bottom_nav_bar_pharma" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/pharmacist_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/pharmacist_drawer_menu"
        app:headerLayout="@layout/nav_header_pharmacist"
        android:background="@color/white_dove" />

</androidx.drawerlayout.widget.DrawerLayout>
