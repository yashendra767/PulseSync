<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_dove"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Home"
    android:padding="4dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello Admin"
                android:textSize="35sp"
                android:fontFamily="@font/lufga_regular">
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:fontFamily="@font/lufga_regular"
                android:layout_marginTop="20dp"
                android:layout_marginStart="7dp"
                android:text="Quick Stats">
            </TextView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="5dp"
                    android:backgroundTint="@color/primary_blue"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="10dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Users"
                            android:textSize="23sp"
                            android:fontFamily="@font/lufga_regular">
                        </TextView>

                        <TextView
                            android:id="@+id/tvTotalUsers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="nos of users"
                            android:textSize="18dp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/source_sans_pro">
                        </TextView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="5dp"
                    android:backgroundTint="@color/primary_green"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Available Beds"
                            android:textSize="23sp"
                            android:fontFamily="@font/lufga_regular">
                        </TextView>

                        <TextView
                            android:id="@+id/tvBedsAvailable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="nos of beds"
                            android:textSize="18dp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/lufga_regular">
                        </TextView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="5dp"
                    android:backgroundTint="@color/primary_yellow"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="10dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admission"
                            android:textSize="23sp"
                            android:fontFamily="@font/lufga_regular">
                        </TextView>

                        <TextView
                            android:id="@+id/tvTotalAdmissions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="nos of adm"
                            android:textSize="18dp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/lufga_regular">

                        </TextView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="5dp"
                    android:backgroundTint="@color/primary_red"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inventory Items"
                            android:textSize="23sp"
                            android:fontFamily="@font/lufga_regular">
                        </TextView>

                        <TextView
                            android:id="@+id/tvTotalInventory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="nos of items"
                            android:textSize="18dp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/lufga_regular">
                        </TextView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admissions Overview"
                android:textSize="24sp"
                android:fontFamily="@font/lufga_regular"
                android:layout_marginTop="18dp"
                android:layout_marginStart="16dp"/>

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChartAdmissions"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_margin="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vitals Over Time"
                android:textSize="24sp"
                android:fontFamily="@font/lufga_regular"
                android:layout_marginTop="18dp"
                android:layout_marginStart="16dp"/>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChartVitals"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_margin="12dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>