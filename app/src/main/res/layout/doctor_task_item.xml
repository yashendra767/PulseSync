<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardElevation="5dp"
    android:layout_margin="8dp"
    android:backgroundTint="@color/white_dove"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white_dove"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checkup: Patient Y"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/textTaskTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10:30 AM - Room 12"
                android:textSize="15sp"
                android:textColor="#666"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkBoxComplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            app:buttonTint="@color/primary_blue" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
