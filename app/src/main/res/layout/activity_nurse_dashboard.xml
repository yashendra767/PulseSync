<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nurse_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_dove"
    tools:context=".nurse.NurseDashboard">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/nurse_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Nurse Dashboard"
            android:background="@color/primary_green"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

        <FrameLayout
            android:id="@+id/nurse_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nurse_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white_dove"
            app:menu="@menu/bottom_nav_bar" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nurse_nav_view"
        android:layout_width="wrap_content"
        android:background="@color/white_dove"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/nurse_drawer_menu"
        app:headerLayout="@layout/nav_header_nurse" />
</androidx.drawerlayout.widget.DrawerLayout>
